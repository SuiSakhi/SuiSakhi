// ============================================================================
// SuiSakhi Firestore Security Rules
// COMMENT MARKER POLICY:
// - RULE-ID values uniquely identify repeated authorization branches.
// - Comments describe intent only and must never replace emulator regression tests.
// - Any logic change must be reviewed separately from comment-only maintenance.
//
// =====================================================
// RULE ID INDEX
// =====================================================
//
// FN-*   = Helper Functions
// COLL-* = Collection Entry Points
// PA-*   = Partner Application Lifecycle
//
// PA-APPLICANT-* = Applicant Actions
// PA-ADMIN-*     = Admin Actions
// PA-TAILOR-*    = Tailor Onboarding Sections
//
// KYC-*  = KYC Lifecycle Rules
// ORD-*  = Order Lifecycle Rules
// SUB-*  = Submission Lifecycle Rules
//
// * means "all Rule IDs starting with the prefix".
//
// Example:
// FN-AUTH-SIGNED-IN      belongs to FN-*
// PA-TAILOR-CAPABILITY-DRAFT belongs to PA-*
//
// ============================================================================
rules_version = '2';
// Deploy: firebase deploy --only firestore:rules --project YOUR_PROJECT_ID
// Or: Firebase Console → Firestore Database → Rules → Publish
service cloud.firestore {
  match /databases/{database}/documents {

    // =====================================================
    // RULE-ID: FN-AUTH-SIGNED-IN
    // ACTOR: Rules engine
    // RESOURCE: Authentication context
    // OPERATION: Check authentication
    // PURPOSE: Returns true only when Firebase Authentication context exists.
    // =====================================================
    function signedIn() {
      return request.auth != null;
    }

    // =====================================================
    // RULE-ID: FN-AUTH-PHONE
    // ACTOR: Rules engine
    // RESOURCE: Authentication token
    // OPERATION: Validate phone claim
    // PURPOSE: Requires a signed-in user with a non-empty verified phone_number claim.
    // =====================================================
    function hasAuthenticatedPhone() {
      return signedIn()
        && request.auth.token.phone_number is string
        && request.auth.token.phone_number.size() > 0;
    }

    // =====================================================
    // RULE-ID: FN-ACCOUNT-OWNERSHIP
    // ACTOR: Rules engine
    // RESOURCE: Account
    // OPERATION: Verify account ownership
    // PURPOSE: Matches the account mobile number to the authenticated phone claim.
    // =====================================================
    function ownsExistingAccount(accountId) {
      return hasAuthenticatedPhone()
        && get(
          /databases/$(database)/documents/accounts/$(accountId)
        ).data.mobileE164 == request.auth.token.phone_number;
    }
    // =====================================================
    // RULE-ID: FN-CUSTOMER-PROFILE-OWNERSHIP
    // ACTOR: Rules engine
    // RESOURCE: Customer profile
    // OPERATION: Verify active profile ownership
    // PURPOSE: Requires an owned account and an active Customer profile.
    // =====================================================
    function ownsActiveCustomerProfile(accountId, profileId) {
      return ownsExistingAccount(accountId)
        && get(
          /databases/$(database)/documents/accounts/$(accountId)
            /profiles/$(profileId)
        ).data.role == 'customer'
        && get(
          /databases/$(database)/documents/accounts/$(accountId)
            /profiles/$(profileId)
        ).data.status == 'active';
    }
    // Garment Care Partner identity helper: all operational records are scoped
    // to an approved Partner profile under the authenticated account.
    function isActiveGarmentCarePartner(accountId, profileId) {
      return accountId is string
        && profileId is string
        && hasAuthenticatedPhone()
        && get(/databases/$(database)/documents/accounts/$(accountId)).data.mobileE164
            == request.auth.token.phone_number
        && get(/databases/$(database)/documents/accounts/$(accountId)/profiles/$(profileId)).data.role
            == 'partner'
        && get(/databases/$(database)/documents/accounts/$(accountId)/profiles/$(profileId)).data.partnerType
            == 'garmentCare'
        && get(/databases/$(database)/documents/accounts/$(accountId)/profiles/$(profileId)).data.status
            == 'active'
        && get(/databases/$(database)/documents/accounts/$(accountId)/profiles/$(profileId)).data.operationalStatus
            == 'active'
        && get(/databases/$(database)/documents/accounts/$(accountId)/profiles/$(profileId)).data.activationStatus
            == 'active'
        && get(/databases/$(database)/documents/accounts/$(accountId)/profiles/$(profileId)).data.approvalStatus
            == 'approved'
        && get(/databases/$(database)/documents/accounts/$(accountId)/profiles/$(profileId)).data.kycStatus
            == 'verified';
    }

    // A registered Delivery Partner can read only Garment Care return
    // shipments explicitly routed to or currently held by that profile.
    function isActiveGarmentCareDeliveryPartner(accountId, profileId) {
      return accountId is string
        && profileId is string
        && hasAuthenticatedPhone()
        && get(/databases/$(database)/documents/accounts/$(accountId)).data.mobileE164
            == request.auth.token.phone_number
        && get(/databases/$(database)/documents/accounts/$(accountId)/profiles/$(profileId)).data.role
            == 'partner'
        && get(/databases/$(database)/documents/accounts/$(accountId)/profiles/$(profileId)).data.partnerType
            == 'deliveryPartner'
        && get(/databases/$(database)/documents/accounts/$(accountId)/profiles/$(profileId)).data.status
            == 'active'
        && get(/databases/$(database)/documents/accounts/$(accountId)/profiles/$(profileId)).data.operationalStatus
            == 'active'
        && get(/databases/$(database)/documents/accounts/$(accountId)/profiles/$(profileId)).data.activationStatus
            == 'active'
        && get(/databases/$(database)/documents/accounts/$(accountId)/profiles/$(profileId)).data.approvalStatus
            == 'approved'
        && get(/databases/$(database)/documents/accounts/$(accountId)/profiles/$(profileId)).data.kycStatus
            == 'verified';
    }

    function ownsGarmentCareOrder(orderId) {
      return signedIn()
        && get(/databases/$(database)/documents/garment_care_orders/$(orderId)).data.customerUid
            == request.auth.uid;
    }

    // =====================================================
    // RULE-ID: FN-ADMIN-AUTHORIZATION
    // ACTOR: Rules engine
    // RESOURCE: Admin configuration
    // OPERATION: Verify configured Admin
    // PURPOSE: Authorizes only UIDs listed in config/admin.adminUids.
    // =====================================================
    function isConfiguredAdmin() {
      return signedIn()
        && 'adminUids' in get(
          /databases/$(database)/documents/config/admin
        ).data
        && get(
          /databases/$(database)/documents/config/admin
        ).data.adminUids is list
        && request.auth.uid in get(
          /databases/$(database)/documents/config/admin
        ).data.adminUids;
    }

    // Authorizes support staff only when their UID is explicitly configured.
    function isConfiguredSupportAgent() {
      return signedIn()
        && exists(/databases/$(database)/documents/config/support)
        && 'supportUids' in get(
          /databases/$(database)/documents/config/support
        ).data
        && get(
          /databases/$(database)/documents/config/support
        ).data.supportUids is list
        && request.auth.uid in get(
          /databases/$(database)/documents/config/support
        ).data.supportUids;
    }

    // =====================================================
    // RULE-ID: FN-CATALOGUE-APPROVED-DESIGNER
    // ACTOR: Rules engine
    // RESOURCE: Designer Partner profile
    // OPERATION: Verify catalogue submission identity
    // PURPOSE: Allows catalogue creation only for the signed-in account's active,
    //          approved, KYC-verified Designer profile.
    // =====================================================
    function isApprovedCatalogueDesigner(accountId, profileId) {
      return hasAuthenticatedPhone()
        && accountId is string
        && accountId.size() > 0
        && profileId is string
        && profileId.size() > 0
        && get(
          /databases/$(database)/documents/accounts/$(accountId)
        ).data.mobileE164 == request.auth.token.phone_number
        && get(
          /databases/$(database)/documents/accounts/$(accountId)
            /profiles/$(profileId)
        ).data.role == 'partner'
        && get(
          /databases/$(database)/documents/accounts/$(accountId)
            /profiles/$(profileId)
        ).data.partnerType == 'designer'
        && get(
          /databases/$(database)/documents/accounts/$(accountId)
            /profiles/$(profileId)
        ).data.status == 'active'
        && get(
          /databases/$(database)/documents/accounts/$(accountId)
            /profiles/$(profileId)
        ).data.operationalStatus == 'active'
        && get(
          /databases/$(database)/documents/accounts/$(accountId)
            /profiles/$(profileId)
        ).data.activationStatus == 'active'
        && get(
          /databases/$(database)/documents/accounts/$(accountId)
            /profiles/$(profileId)
        ).data.approvalStatus == 'approved'
        && get(
          /databases/$(database)/documents/accounts/$(accountId)
            /profiles/$(profileId)
        ).data.kycStatus == 'verified';
    }

    // =====================================================
    // RULE-ID: FN-APPROVED-FASHION-STORE-PARTNER
    // ACTOR: Rules engine
    // RESOURCE: Brand or Boutique Partner profile
    // OPERATION: Verify store listing ownership
    // PURPOSE: Allows only the signed-in account's active, approved,
    //          KYC-verified Brand/Boutique profile to manage its listings.
    // =====================================================
    function isApprovedFashionStorePartner(accountId, profileId) {
      return hasAuthenticatedPhone()
        && accountId is string
        && accountId.size() > 0
        && profileId is string
        && profileId.size() > 0
        && get(
          /databases/$(database)/documents/accounts/$(accountId)
        ).data.mobileE164 == request.auth.token.phone_number
        && get(
          /databases/$(database)/documents/accounts/$(accountId)
            /profiles/$(profileId)
        ).data.role == 'partner'
        && get(
          /databases/$(database)/documents/accounts/$(accountId)
            /profiles/$(profileId)
        ).data.partnerType in ['brand', 'boutique']
        && get(
          /databases/$(database)/documents/accounts/$(accountId)
            /profiles/$(profileId)
        ).data.status == 'active'
        && get(
          /databases/$(database)/documents/accounts/$(accountId)
            /profiles/$(profileId)
        ).data.operationalStatus == 'active'
        && get(
          /databases/$(database)/documents/accounts/$(accountId)
            /profiles/$(profileId)
        ).data.activationStatus == 'active'
        && get(
          /databases/$(database)/documents/accounts/$(accountId)
            /profiles/$(profileId)
        ).data.approvalStatus == 'approved'
        && get(
          /databases/$(database)/documents/accounts/$(accountId)
            /profiles/$(profileId)
        ).data.kycStatus == 'verified';
    }

    // Profile + phone lookup field (used after first successful save)
    // =====================================================
    // RULE-ID: COLL-USERS
    // ACTOR: Authenticated user
    // RESOURCE: User lookup document
    // OPERATION: Read and write own UID document
    // PURPOSE: Protects each user document by Firebase UID.
    // =====================================================
    match /users/{userId} {
      allow read, write: if signedIn() && request.auth.uid == userId;
    }

    // One doc per mobile (digits-only id). Anyone can read a single doc to show
    // "already registered as …" before OTP. Only the signed-in user may write their row.
    // =====================================================
    // RULE-ID: COLL-PHONE-REGISTRY
    // ACTOR: Applicant
    // RESOURCE: Phone registry
    // OPERATION: Read registration state and maintain own row
    // PURPOSE: Supports pre-OTP single-document lookup and authenticated ownership writes.
    // =====================================================
    match /phoneRegistry/{digits} {
      allow get: if true;
      allow list: if false;
      // uid/role required; name optional (some clients send it later). All scalar types must match.
      allow create, update: if signedIn()
          && request.resource.data.uid is string
          && request.resource.data.uid == request.auth.uid
          && request.resource.data.role is string
          && (!('name' in request.resource.data)
              || request.resource.data.name is string);
      allow delete: if signedIn() && resource.data.uid == request.auth.uid;
    }
    // Mobile-to-account lookup used after Firebase phone authentication.
    //
    // The document ID is normalized as:
    // m_<country code and mobile digits>
    // Example: m_919850799272
    //
    // A signed-in user may read the lookup required to restore the
    // generated SuiSakhi account and selected customer profile.
    // =====================================================
    // RULE-ID: COLL-MOBILE-ACCOUNTS
    // ACTOR: Authenticated user
    // RESOURCE: Mobile-account mapping
    // OPERATION: Restore or establish account mapping
    // PURPOSE: Maps a normalized mobile identifier to a generated SuiSakhi account.
    // =====================================================
    match /mobile_accounts/{mobileAccountId} {
      allow read: if signedIn();

      // Account mapping must be created and maintained only through
      // the controlled application account-foundation flow.
      allow create, update: if signedIn()
        && request.resource.data.accountId is string
        && request.resource.data.accountId.size() > 0;

      allow delete: if false;
    }
    // Account and account-owned profile context.
    //
    // Account ownership is verified against the phone number supplied by
    // Firebase Phone Authentication.
    // =====================================================
    // RULE-ID: COLL-ACCOUNTS
    // ACTOR: Account owner
    // RESOURCE: Account
    // OPERATION: Create, read, or update owned account
    // PURPOSE: Uses the authenticated phone claim as the account ownership boundary.
    // =====================================================
    match /accounts/{accountId} {
      allow create: if hasAuthenticatedPhone()
        && request.resource.data.accountId == accountId
        && request.resource.data.mobileE164
            == request.auth.token.phone_number;

      allow read, update: if hasAuthenticatedPhone()
        && resource.data.mobileE164
            == request.auth.token.phone_number;

      allow delete: if false;

      // Customer and partner profiles belonging to this account.
      // =====================================================
      // RULE-ID: COLL-ACCOUNT-PROFILES
      // ACTOR: Account owner
      // RESOURCE: Account profile
      // OPERATION: Read, create, or update profile
      // PURPOSE: Keeps Customer and Partner profiles under the owning account.
      // =====================================================
      match /profiles/{profileId} {
        // =====================================================
        // RULE-ID: AP-READ-OWNED-OR-ADMIN
        // ACTOR: Account owner or configured Admin
        // RESOURCE: Account profile
        // OPERATION: Read profile
        // PURPOSE: Allows profile selection for the account owner and
        //          governed profile review for configured Admin.
        // =====================================================
        allow read: if ownsExistingAccount(accountId)
          || isConfiguredAdmin();

        // =====================================================
        // RULE-ID: AP-CUSTOMER-PROFILE-CREATE
        // ACTOR: Account owner
        // RESOURCE: Customer profile
        // OPERATION: Create profile
        // PURPOSE: Preserves Customer-first profile creation while
        //          preventing an account owner from self-activating
        //          a Partner Business Profile.
        // =====================================================
        allow create: if ownsExistingAccount(accountId)
          && request.resource.data.accountId == accountId
          && request.resource.data.profileId == profileId
          && request.resource.data.role == 'customer'
          && request.resource.data.profileType == 'customer'
          && request.resource.data.status == 'active'
          && request.resource.data.isDefaultProfile == true;

        // =====================================================
        // RULE-ID: AP-PARTNER-PROFILE-ACTIVATE
        // ACTOR: Configured Admin
        // RESOURCE: Partner Business Profile
        // OPERATION: Create active profile after KYC and approval
        // PURPOSE: Creates an independent Partner Business Profile.
        //
        // The paired Partner Application approval rule validates the
        // application, account, category, and profile linkage in the
        // same atomic transaction.
        // =====================================================
        allow create: if isConfiguredAdmin()
          && request.resource.data.accountId == accountId
          && request.resource.data.profileId == profileId
          && request.resource.data.role == 'partner'
          && request.resource.data.profileType == 'partner'
          && request.resource.data.partnerType is string
          && request.resource.data.partnerType.size() > 0
          && request.resource.data.status == 'active'
          && request.resource.data.operationalStatus == 'active'
          && request.resource.data.activationStatus == 'active'
          && request.resource.data.approvalStatus == 'approved'
          && request.resource.data.kycStatus == 'verified'
          && request.resource.data.isDefaultProfile == false
          && request.resource.data.sourceApplicationId is string
          && request.resource.data.sourceApplicationId.size() > 0
          && request.resource.data.approvedByUid
              == request.auth.uid
          && request.resource.data.approvedAt != null;

        // =====================================================
        // RULE-ID: AP-CUSTOMER-PROFILE-UPDATE
        // ACTOR: Account owner
        // RESOURCE: Existing Customer profile
        // OPERATION: Update Customer profile
        // PURPOSE: Preserves existing Customer profile management.
        // =====================================================
        allow update: if ownsExistingAccount(accountId)
          && resource.data.role == 'customer'
          && request.resource.data.role == resource.data.role
          && request.resource.data.accountId == resource.data.accountId
          && request.resource.data.profileId == resource.data.profileId;

        // =====================================================
        // RULE-ID: AP-PARTNER-SELECTION-AUDIT
        // ACTOR: Account owner
        // RESOURCE: Active Partner Business Profile
        // OPERATION: Record profile selection
        // PURPOSE: Allows profile selection without permitting the
        //          account owner to alter KYC, approval, or activation.
        // =====================================================
        allow update: if ownsExistingAccount(accountId)
          && resource.data.role == 'partner'
          && request.resource.data.role == resource.data.role
          && request.resource.data.accountId == resource.data.accountId
          && request.resource.data.profileId == resource.data.profileId
          && request.resource.data.diff(resource.data)
            .affectedKeys()
            .hasOnly([
              'lastSelectedAt',
              'updatedAt'
            ]);

        // =====================================================
        // RULE-ID: AP-OWNER-SELECTION-AUDIT
        // ACTOR: Account owner
        // RESOURCE: Legacy Owner profile
        // OPERATION: Record profile selection
        // PURPOSE: Allows the account owner to select an existing Owner
        //          profile while limiting the write to audit timestamps.
        // =====================================================
        allow update: if ownsExistingAccount(accountId)
          && resource.data.role == 'owner'
          && request.resource.data.role == resource.data.role
          && request.resource.data.accountId == resource.data.accountId
          && request.resource.data.profileId == resource.data.profileId
          && request.resource.data.diff(resource.data)
            .affectedKeys()
            .hasOnly([
              'lastSelectedAt',
              'updatedAt'
            ]);

        // =====================================================
        // RULE-ID: AP-PARTNER-ADMIN-UPDATE
        // ACTOR: Configured Admin
        // RESOURCE: Partner Business Profile
        // OPERATION: Govern lifecycle information
        // PURPOSE: Reserves Partner activation and governance changes
        //          for configured Admin.
        // =====================================================
        allow update: if isConfiguredAdmin()
          && resource.data.role == 'partner'
          && request.resource.data.role == resource.data.role
          && request.resource.data.accountId == resource.data.accountId
          && request.resource.data.profileId == resource.data.profileId;

        allow delete: if false;

        // Server-issued, profile-scoped Tailor offers. The account/profile path
        // scopes reads; callable Functions alone create or change offer state.
        match /order_offers/{offerId} {
          allow read: if ownsExistingAccount(accountId)
            && get(
              /databases/$(database)/documents/accounts/$(accountId)
                /profiles/$(profileId)
            ).data.partnerType == 'tailor';
          allow write: if false;
        }

        // Family members belong to the owning Customer profile.
        // Archived members remain available for historical records but
        // are excluded by application queries for new orders.
        // =====================================================
        // RULE-ID: COLL-FAMILY-MEMBERS
        // ACTOR: Account owner
        // RESOURCE: Family member
        // OPERATION: Read, create, or archive/update family member
        // PURPOSE: Preserves family-member records for historical references; physical delete is denied.
        // =====================================================
        match /family_members/{familyMemberId} {
          allow read, create, update: if ownsExistingAccount(accountId);
          allow delete: if false;
        }
      }

      // Addresses belonging to this account.
      // =====================================================
      // RULE-ID: COLL-ACCOUNT-ADDRESSES
      // ACTOR: Account owner
      // RESOURCE: Address
      // OPERATION: Manage account addresses
      // PURPOSE: Scopes addresses to the authenticated account owner.
      // =====================================================
      match /addresses/{addressId} {
        allow read, create, update: if ownsExistingAccount(accountId);
        allow delete: if ownsExistingAccount(accountId);
      }
    }
    // Measurements owned by an account.
    // =====================================================
    // RULE-ID: COLL-MEASUREMENTS
    // ACTOR: Account owner
    // RESOURCE: Measurement
    // OPERATION: Create, read, or update measurement
    // PURPOSE: Scopes measurement access to the owning account; physical delete is denied.
    // =====================================================
    match /measurements/{measurementId} {

      allow read: if signedIn()
        && resource.data.accountId is string
        && ownsExistingAccount(resource.data.accountId);

      allow create: if signedIn()
        && request.resource.data.accountId is string
        && ownsExistingAccount(
            request.resource.data.accountId
          );

      //allow update: if signedIn()
      allow update: if signedIn()
        && resource.data.accountId is string
        && request.resource.data.accountId == resource.data.accountId
        && ownsExistingAccount(resource.data.accountId);

      allow delete: if false;
    }
    // Customer-owned Partner Applications.
    //
    // Creating or submitting an application does not create an active
    // Partner profile. Only a future Admin approval workflow may approve
    // an application and populate approvedPartnerProfileId.
    // =====================================================
    // RULE-ID: COLL-PARTNER-APPLICATIONS
    // ACTOR: Applicant and configured Admin
    // RESOURCE: Partner application
    // OPERATION: Manage applicant and Admin lifecycle operations
    // PURPOSE: Separates applicant-owned onboarding edits from Admin review, KYC, and decision actions.
    // =====================================================
    match /partner_applications/{applicationId} {
      // =====================================================
      // RULE-ID: PA-APPLICANT-CREATE-DRAFT
      // ACTOR: Applicant
      // RESOURCE: Partner application
      // OPERATION: Create draft application
      // STATUS: new -> draft
      // PURPOSE: Creates an applicant-owned Draft without activating a Partner profile.
      // =====================================================
      allow create: if signedIn()
        && request.resource.data.applicationId == applicationId
        && request.resource.data.createdByUid == request.auth.uid
        && request.resource.data.accountId is string
        && request.resource.data.accountId.size() > 0
        && request.resource.data.customerProfileId is string
        && request.resource.data.customerProfileId.size() > 0
        && ownsActiveCustomerProfile(
          request.resource.data.accountId,
          request.resource.data.customerProfileId
        )
        && request.resource.data.partnerType in [
          'tailor',
          'measurementPartner',
          'garmentCare',
          'boutique',
          'designer',
          'fabricSupplier',
          'printing',
          'embroidery',
          'rental',
          'accessories',
          'brand',
          'deliveryPartner',
          'doorstepServices',
          'other'
        ]
        && request.resource.data.status == 'draft'
        && request.resource.data.reviewedAt == null
        && request.resource.data.reviewedByUid == null
        && request.resource.data.reviewNotes == null
        && request.resource.data.rejectionReason == null
        && request.resource.data.approvedPartnerProfileId == null;

      // =====================================================
      // RULE-ID: PA-READ
      // ACTOR: Applicant or configured Admin
      // RESOURCE: Partner application
      // OPERATION: Read application
      // PURPOSE: Allows Admin review access or applicant access to an owned active Customer profile application.
      // =====================================================
      allow read: if isConfiguredAdmin()
        || (
          signedIn()
          && resource.data.createdByUid == request.auth.uid
          && resource.data.accountId is string
          && resource.data.customerProfileId is string
          && ownsActiveCustomerProfile(
            resource.data.accountId,
            resource.data.customerProfileId
          )
        );
      // Configured Admin may reject an application that is under review.
    // Configured Admin may update the Workshop Details onboarding status.
  //
  // Allowed lifecycle:
  // notStarted -> inProgress
  // inProgress -> completed
  // completed -> verified
  // changesRequired -> inProgress
  // =====================================================
  // RULE-ID: PA-ADMIN-WORKSHOP-STATUS
  // ACTOR: Configured Admin
  // RESOURCE: Partner application
  // OPERATION: Update Workshop Details section status
  // STATUS: underReview -> underReview
  // SECTION: Workshop Details
  // PURPOSE: Maintains the governed Workshop Details section-status lifecycle while the application remains under review.
  // =====================================================
  allow update: if isConfiguredAdmin()
    && resource.data.status == 'underReview'
    && request.resource.data.status
        == resource.data.status
    && request.resource.data.applicationId
        == resource.data.applicationId
    && request.resource.data.createdByUid
        == resource.data.createdByUid
    && request.resource.data.accountId
        == resource.data.accountId
    && request.resource.data.customerProfileId
        == resource.data.customerProfileId
    && request.resource.data.partnerType
        == resource.data.partnerType
    && request.resource.data.approvedPartnerProfileId
        == resource.data.approvedPartnerProfileId
    && request.resource.data.onboardingSections is map
    && request.resource.data.onboardingUpdatedByUid
        == request.auth.uid
    && request.resource.data.onboardingUpdatedAt != null

    && (
      (
        resource.data
            .get('onboardingSections', {})
            .get('workshopDetails', 'notStarted')
            == 'notStarted'
        && request.resource.data
            .onboardingSections
            .workshopDetails
            == 'inProgress'
      )
      ||
      (
        resource.data
            .get('onboardingSections', {})
            .get('workshopDetails', 'notStarted')
            == 'inProgress'
        && request.resource.data
            .onboardingSections
            .workshopDetails
            == 'completed'
      )
      ||
      (
        resource.data
            .get('onboardingSections', {})
            .get('workshopDetails', 'notStarted')
            == 'completed'
        && request.resource.data
            .onboardingSections
            .workshopDetails
            == 'verified'
      )
      ||
      (
        resource.data
            .get('onboardingSections', {})
            .get('workshopDetails', 'notStarted')
            == 'changesRequired'
        && request.resource.data
            .onboardingSections
            .workshopDetails
            == 'inProgress'
      )
    )

    && request.resource.data.onboardingSections
      .diff(
        resource.data.get('onboardingSections', {})
      )
      .affectedKeys()
      .hasOnly([
        'workshopDetails'
      ])

    && request.resource.data.diff(resource.data)
      .affectedKeys()
      .hasOnly([
        'onboardingSections',
        'onboardingUpdatedByUid',
        'onboardingUpdatedAt',
        'updatedAt'
      ]);
      // Configured Admin may start KYC verification while an application
      // Configured Admin may mark KYC as verified while an application
  // is under review and KYC is under verification.
  // =====================================================
  // RULE-ID: PA-ADMIN-KYC-VERIFY
  // ACTOR: Configured Admin
  // RESOURCE: Partner application
  // OPERATION: Mark KYC verified
  // STATUS: underReview -> underReview
  // KYC: underVerification -> verified
  // PURPOSE: Completes KYC verification while preserving application ownership and Partner linkage.
  // =====================================================
  allow update: if isConfiguredAdmin()
    && resource.data.status == 'underReview'
    && request.resource.data.status
        == resource.data.status
    && resource.data.kycStatus == 'underVerification'
    && request.resource.data.kycStatus == 'verified'
    && request.resource.data.applicationId
        == resource.data.applicationId
    && request.resource.data.createdByUid
        == resource.data.createdByUid
    && request.resource.data.accountId
        == resource.data.accountId
    && request.resource.data.customerProfileId
        == resource.data.customerProfileId
    && request.resource.data.partnerType
        == resource.data.partnerType
    && request.resource.data.approvedPartnerProfileId
        == resource.data.approvedPartnerProfileId
    && request.resource.data.kycVerifiedByUid
        == request.auth.uid
    && request.resource.data.kycVerifiedAt != null
    && request.resource.data.kycUpdatedAt != null
    && request.resource.data.kycFailureReason == null
    && request.resource.data.diff(resource.data)
      .affectedKeys()
      .hasOnly([
        'kycStatus',
        'kycVerifiedByUid',
        'kycVerifiedAt',
        'kycUpdatedAt',
        'kycFailureReason',
        'updatedAt'
      ]);
      // Configured Admin may mark KYC as failed with a customer-visible
      // reason while an application is under review.
      // =====================================================
      // RULE-ID: PA-ADMIN-KYC-FAIL
      // ACTOR: Configured Admin
      // RESOURCE: Partner application
      // OPERATION: Mark KYC failed
      // STATUS: underReview -> underReview
      // KYC: underVerification -> failed
      // PURPOSE: Records a customer-visible KYC failure reason without changing application ownership.
      // =====================================================
      allow update: if isConfiguredAdmin()
        && resource.data.status == 'underReview'
        && request.resource.data.status
            == resource.data.status
        && resource.data.kycStatus == 'underVerification'
        && request.resource.data.kycStatus == 'failed'
        && request.resource.data.applicationId
            == resource.data.applicationId
        && request.resource.data.createdByUid
            == resource.data.createdByUid
        && request.resource.data.accountId
            == resource.data.accountId
        && request.resource.data.customerProfileId
            == resource.data.customerProfileId
        && request.resource.data.partnerType
            == resource.data.partnerType
        && request.resource.data.approvedPartnerProfileId
            == resource.data.approvedPartnerProfileId
        && request.resource.data.kycVerifiedByUid == null
        && request.resource.data.kycVerifiedAt == null
        && request.resource.data.kycUpdatedAt != null
        && request.resource.data.kycFailureReason is string
        && request.resource.data.kycFailureReason.size() >= 10
        && request.resource.data.diff(resource.data)
          .affectedKeys()
          .hasOnly([
            'kycStatus',
            'kycVerifiedByUid',
            'kycVerifiedAt',
            'kycUpdatedAt',
            'kycFailureReason',
            'updatedAt'
          ]);
      // is under review.
      // =====================================================
      // RULE-ID: PA-ADMIN-KYC-START
      // ACTOR: Configured Admin
      // RESOURCE: Partner application
      // OPERATION: Start KYC verification
      // STATUS: underReview -> underReview
      // KYC: notStarted -> underVerification
      // PURPOSE: Moves KYC from absent or notStarted to underVerification.
      // =====================================================
      allow update: if isConfiguredAdmin()
        && resource.data.status == 'underReview'
        && request.resource.data.status
            == resource.data.status
        && (
          !('kycStatus' in resource.data)
          || resource.data.kycStatus == 'notStarted'
        )
        && request.resource.data.kycStatus
            == 'underVerification'
        && request.resource.data.applicationId
            == resource.data.applicationId
        && request.resource.data.createdByUid
            == resource.data.createdByUid
        && request.resource.data.accountId
            == resource.data.accountId
        && request.resource.data.customerProfileId
            == resource.data.customerProfileId
        && request.resource.data.partnerType
            == resource.data.partnerType
        && request.resource.data.approvedPartnerProfileId
            == resource.data.approvedPartnerProfileId
        && request.resource.data.kycUpdatedAt != null
        && request.resource.data.kycFailureReason == null
        && request.resource.data.diff(resource.data)
          .affectedKeys()
          .hasOnly([
            'kycStatus',
            'kycUpdatedAt',
            'kycFailureReason',
            'updatedAt'
          ]);
      // Rejection preserves application ownership and history and requires
      // a customer-visible reason.
      // =====================================================
      // RULE-ID: PA-ADMIN-REJECT
      // ACTOR: Configured Admin
      // RESOURCE: Partner application
      // OPERATION: Reject application
      // STATUS: underReview -> rejected
      // PURPOSE: Rejects an under-review application with required audit fields and customer-visible reason.
      // =====================================================
      allow update: if isConfiguredAdmin()
        && resource.data.status == 'underReview'
        && request.resource.data.status == 'rejected'
        && request.resource.data.applicationId
            == resource.data.applicationId
        && request.resource.data.createdByUid
            == resource.data.createdByUid
        && request.resource.data.accountId
            == resource.data.accountId
        && request.resource.data.customerProfileId
            == resource.data.customerProfileId
        && request.resource.data.partnerType
            == resource.data.partnerType
        && request.resource.data.approvedPartnerProfileId
            == resource.data.approvedPartnerProfileId
        && request.resource.data.rejectionReason is string
        && request.resource.data.rejectionReason.size() >= 10
        && request.resource.data.rejectedByUid
            == request.auth.uid
        && request.resource.data.rejectedAt != null
        && request.resource.data.reviewedByUid
            == request.auth.uid
        && request.resource.data.reviewedAt != null
        && request.resource.data.diff(resource.data)
          .affectedKeys()
          .hasOnly([
            'status',
            'rejectionReason',
            'rejectedByUid',
            'rejectedAt',
            'reviewedByUid',
            'reviewedAt',
            'updatedAt'
          ]);
      // Configured Admin may start reviewing a submitted application.
      //
      // This operation cannot modify application ownership, Partner type,
      // applicant-entered information, or approved Partner profile linkage.
      // =====================================================
      // RULE-ID: PA-ADMIN-START-REVIEW
      // ACTOR: Configured Admin
      // RESOURCE: Partner application
      // OPERATION: Start application review
      // STATUS: submitted -> underReview
      // PURPOSE: Moves a submitted application into Admin review without changing applicant data.
      // =====================================================
      allow update: if isConfiguredAdmin()
        && resource.data.status == 'submitted'
        && request.resource.data.status == 'underReview'
        && request.resource.data.applicationId
            == resource.data.applicationId
        && request.resource.data.createdByUid
            == resource.data.createdByUid
        && request.resource.data.accountId
            == resource.data.accountId
        && request.resource.data.customerProfileId
            == resource.data.customerProfileId
        && request.resource.data.partnerType
            == resource.data.partnerType
        && request.resource.data.approvedPartnerProfileId
            == resource.data.approvedPartnerProfileId
        && request.resource.data.reviewedByUid
            == request.auth.uid
        && request.resource.data.reviewedAt != null
        && request.resource.data.diff(resource.data)
          .affectedKeys()
          .hasOnly([
            'status',
            'reviewedByUid',
            'reviewedAt',
            'updatedAt'
          ]);
      // Configured Admin may request corrections while an application
      // is under review.
      // =====================================================
      // RULE-ID: PA-ADMIN-REQUEST-CHANGES
      // ACTOR: Configured Admin
      // RESOURCE: Partner application
      // OPERATION: Request applicant corrections
      // STATUS: underReview -> changesRequested
      // PURPOSE: Returns an under-review application to the applicant with required correction instructions.
      // =====================================================
      allow update: if isConfiguredAdmin()
        && resource.data.status == 'underReview'
        && request.resource.data.status == 'changesRequested'
        && request.resource.data.applicationId
            == resource.data.applicationId
        && request.resource.data.createdByUid
            == resource.data.createdByUid
        && request.resource.data.accountId
            == resource.data.accountId
        && request.resource.data.customerProfileId
            == resource.data.customerProfileId
        && request.resource.data.partnerType
            == resource.data.partnerType
        && request.resource.data.approvedPartnerProfileId
            == resource.data.approvedPartnerProfileId
        && request.resource.data.reviewedByUid
            == request.auth.uid
        && request.resource.data.reviewedAt != null
        && request.resource.data.reviewNotes is string
        && request.resource.data.reviewNotes.size() > 0
        && request.resource.data.rejectionReason == null
        && request.resource.data.diff(resource.data)
          .affectedKeys()
          .hasOnly([
            'status',
            'reviewedByUid',
            'reviewedAt',
            'reviewNotes',
            'rejectionReason',
            'updatedAt'
          ]);

      // =====================================================
      // RULE-ID: PA-ADMIN-APPROVE-ACTIVATE
      // ACTOR: Configured Admin
      // RESOURCE: Partner Application
      // OPERATION: Approve and link Partner Business Profile
      // STATUS: underReview -> approved
      // KYC: verified -> verified
      // PURPOSE: Atomically approves the application and links the
      //          independently activated Partner Business Profile.
      // =====================================================
      allow update: if isConfiguredAdmin()
        && resource.data.status == 'underReview'
        && request.resource.data.status == 'approved'
        && resource.data.kycStatus == 'verified'
        && request.resource.data.kycStatus == 'verified'
        && request.resource.data.applicationId
            == resource.data.applicationId
        && request.resource.data.createdByUid
            == resource.data.createdByUid
        && request.resource.data.accountId
            == resource.data.accountId
        && request.resource.data.customerProfileId
            == resource.data.customerProfileId
        && request.resource.data.partnerType
            == resource.data.partnerType
        && (
          resource.data.approvedPartnerProfileId == null
          || resource.data.approvedPartnerProfileId
              == request.resource.data.approvedPartnerProfileId
        )
        && request.resource.data.approvedPartnerProfileId is string
        && request.resource.data.approvedPartnerProfileId.size() > 0
        && request.resource.data.reviewedByUid == request.auth.uid
        && request.resource.data.reviewedAt != null

        // Validate the Partner Business Profile created by the same
        // atomic transaction.
        && getAfter(
          /databases/$(database)/documents/accounts/$(
            resource.data.accountId
          )/profiles/$(
            request.resource.data.approvedPartnerProfileId
          )
        ).data.role == 'partner'
        && getAfter(
          /databases/$(database)/documents/accounts/$(
            resource.data.accountId
          )/profiles/$(
            request.resource.data.approvedPartnerProfileId
          )
        ).data.accountId == resource.data.accountId
        && getAfter(
          /databases/$(database)/documents/accounts/$(
            resource.data.accountId
          )/profiles/$(
            request.resource.data.approvedPartnerProfileId
          )
        ).data.sourceApplicationId == applicationId
        && getAfter(
          /databases/$(database)/documents/accounts/$(
            resource.data.accountId
          )/profiles/$(
            request.resource.data.approvedPartnerProfileId
          )
        ).data.partnerType == resource.data.partnerType
        && getAfter(
          /databases/$(database)/documents/accounts/$(
            resource.data.accountId
          )/profiles/$(
            request.resource.data.approvedPartnerProfileId
          )
        ).data.kycStatus == 'verified'
        && getAfter(
          /databases/$(database)/documents/accounts/$(
            resource.data.accountId
          )/profiles/$(
            request.resource.data.approvedPartnerProfileId
          )
        ).data.approvalStatus == 'approved'
        && request.resource.data.diff(resource.data)
          .affectedKeys()
          .hasOnly([
            'status',
            'approvedPartnerProfileId',
            'reviewedByUid',
            'reviewedAt',
            'updatedAt'
          ]);
          // =====================================================
          // RULE-ID: PA-APPLICANT-BASIC-DETAILS-STANDALONE
          // ACTOR: Applicant
          // RESOURCE: Partner application
          // OPERATION: Update common Basic Details
          // STATUS: draft or changesRequested, with no transition
          // PURPOSE: Provides an independent authorization path for
          //          common Partner-application Basic Details.
          // PROTECTS: Ownership, application identity, Customer profile,
          //           Partner type, lifecycle status, and Partner linkage.
          // =====================================================
          allow update: if signedIn()
            && resource.data.createdByUid == request.auth.uid
            && request.resource.data.createdByUid
                == resource.data.createdByUid
            && request.resource.data.applicationId
                == resource.data.applicationId
            && request.resource.data.accountId
                == resource.data.accountId
            && request.resource.data.customerProfileId
                == resource.data.customerProfileId
            && request.resource.data.partnerType
                == resource.data.partnerType
            && request.resource.data.status
                == resource.data.status
            && resource.data.status in [
              'draft',
              'changesRequested'
            ]
            && request.resource.data.get(
                  'approvedPartnerProfileId',
                  null
                )
                == resource.data.get(
                  'approvedPartnerProfileId',
                  null
                )
            && request.resource.data.diff(resource.data)
              .affectedKeys()
              .hasOnly([
                'businessName',
                'contactName',
                'mobileE164',
                'additionalContactNumbers',
                'email',
                'updatedAt'
              ]);
      // =====================================================
      // RULE-ID: PA-APPLICANT-UPDATE-GATE
      // ACTOR: Applicant
      // RESOURCE: Partner application
      // OPERATION: Enter controlled applicant update branches
      // PURPOSE: Applies shared authentication, immutable ownership, active Customer profile, and Partner linkage checks before branch-specific edits.
      // =====================================================
      allow update: if signedIn()
        && resource.data.createdByUid == request.auth.uid
        && request.resource.data.createdByUid
            == resource.data.createdByUid
        && request.resource.data.applicationId
            == resource.data.applicationId
        && request.resource.data.accountId
            == resource.data.accountId
        && request.resource.data.customerProfileId
            == resource.data.customerProfileId
        && request.resource.data.partnerType
            == resource.data.partnerType
        && ownsActiveCustomerProfile(
          resource.data.accountId,
          resource.data.customerProfileId
        )
          // RULE-ID: PA-APPLICANT-PARTNER-LINKAGE-IMMUTABLE
          // Keep approved Partner-profile linkage immutable while safely
          // supporting legacy and pre-approval applications where the
          // approvedPartnerProfileId field does not yet exist.
          && request.resource.data.get(
                'approvedPartnerProfileId',
                null
              )
              == resource.data.get(
                'approvedPartnerProfileId',
                null
              )
          && (
          // =====================================================
          // RULE-ID: PA-APPLICANT-OPERATIONAL-EDITABLE
          // ACTOR: Applicant
          // RESOURCE: Partner Application
          // OPERATION: Save operational onboarding information
          // STATUS: draft or changesRequested, with no transition
          // DATA NODE: onboardingData
          // PURPOSE: Phase-1 simplified Save Draft path.
          //          Section completion is informational and does
          //          not control authorization.
          // PROTECTS: Ownership, application lifecycle, KYC,
          //           Admin review, approval, and profile linkage.
          // =====================================================
          (
            resource.data.status in [
              'draft',
              'changesRequested'
            ]
            && request.resource.data.status
                == resource.data.status
            && request.resource.data.onboardingData is map
            && request.resource.data.onboardingUpdatedByUid
                == request.auth.uid
            && request.resource.data.onboardingUpdatedAt != null

            // Only operational onboarding and its audit metadata
            // may change through this simplified Phase-1 path.
            && request.resource.data
              .diff(resource.data)
              .affectedKeys()
              .hasOnly([
                'onboardingData',
                'onboardingSections',
                'onboardingUpdatedByUid',
                'onboardingUpdatedAt',
                'updatedAt'
              ])
          )
          ||
          // =====================================================
          // // =====================================================
          // RULE-ID: PA-APPLICANT-CONTACT-EDITABLE
          // ACTOR: Applicant
          // RESOURCE: Partner application
          // OPERATION: Update applicant contact and business summary
          // STATUS: draft or changesRequested, with no transition
          // SECTION: Basic Details
          // PURPOSE: Allows Basic Details corrections in every
          //          applicant-editable lifecycle status.
          // PROTECTS: Application status, ownership, Partner type,
          //           KYC, Admin review, approval, and Partner linkage.
          // =====================================================
          (
            resource.data.status in [
              'draft',
              'changesRequested'
            ]
            && request.resource.data.status
                == resource.data.status
            && request.resource.data.diff(resource.data)
              .affectedKeys()
              .hasOnly([
                'businessName',
                'contactName',
                'mobileE164',
                'additionalContactNumbers',
                'email',
                'updatedAt'
              ])
          )
          ||
          // =====================================================
          // RULE-ID: PA-TAILOR-CAPABILITY-EDITABLE
          // ACTOR: Applicant
          // RESOURCE: Partner Application
          // OPERATION: Save Tailor capabilities
          // STATUS: draft or changesRequested, with no status transition
          // SECTION: Services and Specialization
          // DATA NODE: onboardingData.extensions.tailor.capabilities
          // PURPOSE: Uses one governed validation path for every applicant-editable status.
          // =====================================================
          (
            resource.data.status in [
              'draft',
              'changesRequested'
            ]
            && request.resource.data.status
                == resource.data.status
            && request.resource.data.partnerType == 'tailor'
            && request.resource.data.onboardingData is map
            && request.resource.data.onboardingSections is map
            && request.resource.data.onboardingUpdatedByUid
                == request.auth.uid
            && request.resource.data.onboardingUpdatedAt != null
            && request.resource.data
                .onboardingSections
                .servicesAndSpecialization
                in ['inProgress', 'completed']

            // Only the top-level extensions map may change.
            && request.resource.data.onboardingData
              .diff(
                resource.data.get('onboardingData', {})
              )
              .affectedKeys()
              .hasOnly([
                'extensions'
              ])

            // Inside extensions, only the Tailor extension may change.
            && request.resource.data
                .onboardingData
                .extensions is map
            && request.resource.data
                .onboardingData
                .extensions
              .diff(
                resource.data
                  .get('onboardingData', {})
                  .get('extensions', {})
              )
              .affectedKeys()
              .hasOnly([
                'tailor'
              ])

            // Inside Tailor, only capabilities may change.
            && request.resource.data
                .onboardingData
                .extensions
                .tailor is map
            && request.resource.data
                .onboardingData
                .extensions
                .tailor
              .diff(
                resource.data
                  .get('onboardingData', {})
                  .get('extensions', {})
                  .get('tailor', {})
              )
              .affectedKeys()
              .hasOnly([
                'capabilities'
              ])

            // Capabilities must contain only approved applicant fields.
            && request.resource.data
                .onboardingData
                .extensions
                .tailor
                .capabilities is map
            && request.resource.data
                .onboardingData
                .extensions
                .tailor
                .capabilities
                .keys()
                .hasOnly([
                  'declaredCapabilityCodes',
                  'additionalCapabilityDescriptions'
                ])

            // Both capability values must be lists.
            && request.resource.data
                .onboardingData
                .extensions
                .tailor
                .capabilities
                .declaredCapabilityCodes is list
            && request.resource.data
                .onboardingData
                .extensions
                .tailor
                .capabilities
                .additionalCapabilityDescriptions is list

            // Keep applicant-entered lists within reasonable limits.
            && request.resource.data
                .onboardingData
                .extensions
                .tailor
                .capabilities
                .declaredCapabilityCodes
                .size() <= 50
            && request.resource.data
                .onboardingData
                .extensions
                .tailor
                .capabilities
                .additionalCapabilityDescriptions
                .size() <= 10

            // Declared capability codes must come from governed metadata.
            && request.resource.data
                .onboardingData
                .extensions
                .tailor
                .capabilities
                .declaredCapabilityCodes
                .hasOnly([
                  'tailor.blouseStitching',
                  'tailor.kurtiSuit',
                  'tailor.dressStitching',
                  'tailor.lehenga',
                  'tailor.bridalWear',
                  'tailor.designerWear',
                  'tailor.designerReplication',
                  'tailor.girlsWear',
                  'tailor.alteration',
                  'tailor.sareePicoFall',
                  'tailor.embroidery',
                  'tailor.aari',
                  'tailor.zardozi',
                  'tailor.schoolUniform',
                  'tailor.weddingOrders',
                  'tailor.urgentOrders'
                ])

            // Only the capability-section status may change.
            && request.resource.data.onboardingSections
              .diff(
                resource.data.get('onboardingSections', {})
              )
              .affectedKeys()
              .hasOnly([
                'servicesAndSpecialization'
              ])

            // No unrelated top-level application field may change.
            && request.resource.data.diff(resource.data)
              .affectedKeys()
              .hasOnly([
                'onboardingData',
                'onboardingSections',
                'onboardingUpdatedByUid',
                'onboardingUpdatedAt',
                'updatedAt'
              ])
          )
          ||
          // =====================================================
          // RULE-ID: PA-TAILOR-WORKSHOP-EDITABLE
          // ACTOR: Applicant
          // RESOURCE: Partner Application
          // OPERATION: Save Tailor Workshop Details
          // STATUS: draft or changesRequested, with no status transition
          // SECTION: Business and Operations
          // DATA NODE: onboardingData.extensions.tailor.workshopDetails
          // SECTION NODE: onboardingSections.workshopDetails
          // PURPOSE: Uses one governed Workshop validation path for every applicant-editable status.
          // =====================================================
          (
            resource.data.status in [
              'draft',
              'changesRequested'
            ]
            && request.resource.data.status
                == resource.data.status
            && request.resource.data.partnerType == 'tailor'
            && request.resource.data.onboardingData is map
            && request.resource.data.onboardingSections is map
            && request.resource.data.onboardingUpdatedByUid
                == request.auth.uid
            && request.resource.data.onboardingUpdatedAt != null
            && request.resource.data.onboardingSections.workshopDetails
                in ['inProgress', 'completed']

            // Only the top-level extensions map may change.
            && request.resource.data.onboardingData
              .diff(
                resource.data.get('onboardingData', {})
              )
              .affectedKeys()
              .hasOnly([
                'extensions'
              ])

            // Inside extensions, only the Tailor extension may change.
            && request.resource.data.onboardingData.extensions is map
            && request.resource.data.onboardingData.extensions
              .diff(
                resource.data
                  .get('onboardingData', {})
                  .get('extensions', {})
              )
              .affectedKeys()
              .hasOnly([
                'tailor'
              ])

            // Inside Tailor, only Workshop Details may change.
            && request.resource.data
              .onboardingData
              .extensions
              .tailor is map
            && request.resource.data
              .onboardingData
              .extensions
              .tailor
              .diff(
                resource.data
                  .get('onboardingData', {})
                  .get('extensions', {})
                  .get('tailor', {})
              )
              .affectedKeys()
              .hasOnly([
                'workshopDetails'
              ])

            // Workshop Details must contain only approved fields.
            && request.resource.data
              .onboardingData
              .extensions
              .tailor
              .workshopDetails is map
            && request.resource.data
              .onboardingData
              .extensions
              .tailor
              .workshopDetails
              .keys()
              .hasOnly([
                'workshopTypeCode',
                'addressLine1',
                'addressLine2',
                'locality',
                'city',
                'state',
                'pincode',
                'placeId',
                'latitude',
                'longitude',
                'serviceAreaPincodes',
                'operatingDays',
                'openingTime',
                'closingTime',
                'teamSize',
                'normalDailyCapacity',
                'peakDailyCapacity',
                'machineCodes',
                'pickupAvailable',
                'deliveryAvailable',
                'homeVisitAvailable',
                'additionalNotes'
              ])

            // No other onboarding-section status may change.
            && request.resource.data.onboardingSections
              .diff(
                resource.data.get('onboardingSections', {})
              )
              .affectedKeys()
              .hasOnly([
                'workshopDetails'
              ])

            && request.resource.data.diff(resource.data)
              .affectedKeys()
              .hasOnly([
                'onboardingData',
                'onboardingSections',
                'onboardingUpdatedByUid',
                'onboardingUpdatedAt',
                'updatedAt'
              ])
          )
          ||
          // =====================================================
          // RULE-ID: PA-APPLICANT-SUBMIT-DRAFT
          // ACTOR: Applicant
          // RESOURCE: Partner application
          // OPERATION: Submit Draft for Admin review
          // STATUS: draft -> submitted
          // PURPOSE: Moves a Draft application to submitted and resets review-result fields.
          // =====================================================
          (
            resource.data.status == 'draft'
            && request.resource.data.status == 'submitted'
            && request.resource.data.submittedAt != null
            && request.resource.data.reviewedAt == null
            && request.resource.data.reviewedByUid == null
            && request.resource.data.reviewNotes == null
            && request.resource.data.rejectionReason == null
            && request.resource.data.diff(resource.data)
              .affectedKeys()
              .hasOnly([
                'status',
                'submittedAt',
                'updatedAt',
                'reviewedAt',
                'reviewedByUid',
                'reviewNotes',
                'rejectionReason'
              ])
          )
          ||
          // =====================================================
          // RULE-ID: PA-APPLICANT-RESUBMIT-CHANGES
          // ACTOR: Applicant
          // RESOURCE: Partner application
          // OPERATION: Resubmit corrected application
          // STATUS: changesRequested -> submitted
          // PURPOSE: Moves a corrected changesRequested application back to submitted and resets review-result fields.
          // =====================================================
          (
            resource.data.status == 'changesRequested'
            && request.resource.data.status == 'submitted'
            && request.resource.data.submittedAt != null
            && request.resource.data.reviewedAt == null
            && request.resource.data.reviewedByUid == null
            && request.resource.data.reviewNotes == null
            && request.resource.data.rejectionReason == null
            && request.resource.data.diff(resource.data)
              .affectedKeys()
              .hasOnly([
                'status',
                'submittedAt',
                'updatedAt',
                'reviewedAt',
                'reviewedByUid',
                'reviewNotes',
                'rejectionReason'
              ])
          )
        );

      allow delete: if false;
    }

    // Role lists (owner/tailor/delivery). Any signed-in user may read for routing.
    // Tighten writes in production (e.g. only owner UIDs via custom claims).
    // =====================================================
    // RULE-ID: COLL-CONFIG
    // ACTOR: Authenticated reader; configured Admin writer
    // RESOURCE: Configuration
    // OPERATION: Read governed configuration or perform Admin write
    // PURPOSE: Centralizes governed configuration and Admin authorization data.
    // =====================================================
    match /config/{document=**} {
      allow read: if signedIn();
      allow write: if isConfiguredAdmin();
    }

    // Rate card — customers need read; owner dashboard writes.
    // =====================================================
    // RULE-ID: COLL-RATES
    // ACTOR: Authenticated user
    // RESOURCE: Rate card
    // OPERATION: Read or write rate data
    // PURPOSE: Current broad authenticated access is retained and should be tightened before production.
    // =====================================================
    match /rates/{docId} {
      allow read: if signedIn();
      allow write: if isConfiguredAdmin();
    }

    // =====================================================
    // RULE-ID: COLL-ORDERS
    // ACTOR: Authenticated user
    // RESOURCE: Order
    // OPERATION: Create, read, update, or delete order
    // PURPOSE: Customer creates must match their UID; production order updates are server-owned while legacy test orders retain current access.
    // =====================================================
    match /orders/{orderId} {
      allow read: if signedIn();
      allow create: if signedIn()
          && request.resource.data.customerId == request.auth.uid
          && (request.resource.data.orderModuleType != 'coreTailoring'
            || (request.resource.data.assignmentVersion == 'v1'
              && request.resource.data.assignmentStatus == 'searching'
              && request.resource.data.paymentStatus == 'unpaid'
              && request.resource.data.advancePercent == 50
              && request.resource.data.advanceAmount == 0
              && request.resource.data.status == 'pending'
              && !request.resource.data.keys().hasAny([
                'assignedTailorAccountId',
                'assignedTailorProfileId',
                'assignedTailorName',
                'tailorName',
                'assignmentAcceptedAt',
                'customerDecisionExpiresAt',
                'orderFinalizedAt',
                'orderTrackingId',
                'orderQrPayload',
                'measurementStatus',
                'measurementMethod',
                'measurementPartnerAccountId',
                'measurementPartnerProfileId',
                'measurementPartnerName',
                'measurementAppointmentAt',
                'measurementAppointmentLink',
                'measurementAppointmentScheduledAt',
                'measurementNotes',
                'measurementConfirmedAt',
                'measurementConfirmedByAccountId',
                'measurementConfirmedByProfileId',
                'measurementSubmissionStatus',
                'measurementSubmittedValues',
                'measurementSubmittedUnit',
                'measurementHistory',
                'measurementPartnerCompletionNote',
                'measurementPartnerCompletedAt',
                'measurementPartnerCompletedByAccountId',
                'measurementPartnerCompletedByProfileId',
                'inboundPickupStatus',
                'inboundPickupRequired',
                'inboundPickupPartnerType',
                'inboundPickupPartnerAccountId',
                'inboundPickupPartnerProfileId',
                'inboundPickupAssignedAt',
                'inboundPickupAssignedBy',
                'inboundPickupCollectedAt',
                'inboundPickupCollectedByAccountId',
                'inboundPickupCollectedByProfileId',
                'inboundPickupPhotoPath',
                'inboundPickupPhotoAttachedAt',
                'inboundPickupPhotoAttachedByAccountId',
                'inboundPickupPhotoAttachedByProfileId',
                'inboundPickupReceivedAt',
                'inboundPickupReceivedByAccountId',
                'inboundPickupReceivedByProfileId',
                'inboundPickupDeclinedPartnerKeys',
                'outboundHandoverStatus',
                'outboundHandoverPartnerType',
                'outboundHandoverPartnerAccountId',
                'outboundHandoverPartnerProfileId',
                'outboundHandoverAssignedAt',
                'outboundHandoverAcceptedAt',
                'outboundHandoverDeliveredAt',
                'outboundHandoverDeclinedPartnerKeys',
                'deliveryPartnerId',
                'deliveryPartnerType',
                'deliveryPartnerAccountId',
                'deliveryPartnerProfileId',
                'deliveryAcceptedAt',
                'deliveryPinHash',
                'deliveryPinGeneratedAt',
                'deliveryPinUsedAt',
                'deliveredAt',
                'warrantyClaimStatus',
                'warrantyIssueDescription',
                'warrantyIssueReportedAt',
                'warrantyCustomerPhone',
                'warrantyResolution',
                'warrantyResolvedAt',
                'warrantyResolvedByUid',
                'warrantyResolvedByRole',
                'atTailorAt',
                'adminQueueReason',
                'adminQueueUpdatedAt',
                'nextDispatchAt',
                'amountPaid',
                'paidAt',
                'paymentMethod',
                'paymentProvider',
                'payoutLedger'
              ])));
      // Production orders are immutable to clients after submission. The
      // Admin SDK in trusted Cloud Functions owns assignment/payment changes;
      // existing non-production test orders retain their current behavior.
      allow update: if signedIn() && resource.data.assignmentVersion != 'v1';
      allow delete: if signedIn() && resource.data.assignmentVersion != 'v1';

      match /events/{eventId} {
        allow read: if signedIn();
        allow write: if false;
      }

      // Delivery verification PINs are read only by trusted Cloud Functions.
      match /private/{privateDocumentId} {
        allow read, write: if false;
      }
    }

    // Garment Care uses isolated collections so it cannot change the legacy
    // tailoring order or payment state machines. All workflow writes are made
    // by authenticated Admin SDK callables; clients receive scoped reads only.
    // The one exception is an explicitly owner-scoped, private cart draft.
    match /accounts/{accountId}/profiles/{profileId}/garment_care_cart_drafts/{draftId} {
      // A direct get of the reserved draft path must also succeed when no
      // draft exists yet. The screen treats a missing document as an empty
      // cart; checking resource.data here would deny that first-time read.
      // The account/profile path is already scoped to the authenticated owner.
      allow get: if draftId == 'current'
          && ownsActiveCustomerProfile(accountId, profileId);
      allow list: if false;

      allow create, update: if draftId == 'current'
          && ownsActiveCustomerProfile(accountId, profileId)
          && request.resource.data.customerUid == request.auth.uid
          && request.resource.data.accountId == accountId
          && request.resource.data.profileId == profileId
          && request.resource.data.schemaVersion == 1
          && request.resource.data.items is list
          && request.resource.data.items.size() <= 50
          && request.resource.data.pickupSlotsByGroup is map
          && request.resource.data.pickupSlotsByGroup.size() <= 6
          && request.resource.data.pickupDatesByGroup is map
          && request.resource.data.pickupDatesByGroup.size() <= 6
          && (request.resource.data.pickupAddressId == null
            || request.resource.data.pickupAddressId is string)
          && request.resource.data.updatedAt == request.time
          && request.resource.data.keys().hasOnly([
            'customerUid', 'accountId', 'profileId', 'schemaVersion', 'items',
            'pickupAddressId', 'pickupSlotsByGroup', 'pickupDatesByGroup',
            'updatedAt'
          ]);

      // Clearing an already-empty draft is intentionally idempotent too.
      allow delete: if draftId == 'current'
          && ownsActiveCustomerProfile(accountId, profileId);
    }

    match /garment_identities/{garmentId} {
      allow read: if signedIn() && resource.data.customerUid == request.auth.uid;
      allow create, update, delete: if false;
    }

    match /garment_care_checkouts/{checkoutId} {
      allow read: if signedIn()
          && (resource.data.customerUid == request.auth.uid || isConfiguredAdmin());
      allow create, update, delete: if false;
    }

    match /garment_care_orders/{orderId} {
      allow read: if signedIn()
          && (resource.data.customerUid == request.auth.uid || isConfiguredAdmin());
      allow create, update, delete: if false;

      match /items/{itemId} {
        allow read: if ownsGarmentCareOrder(orderId) || isConfiguredAdmin();
        allow create, update, delete: if false;
      }
      match /delivery_groups/{groupId} {
        allow read: if ownsGarmentCareOrder(orderId) || isConfiguredAdmin();
        allow create, update, delete: if false;
      }
      match /events/{eventId} {
        allow read: if ownsGarmentCareOrder(orderId) || isConfiguredAdmin();
        allow create, update, delete: if false;
      }
    }

    match /garment_care_service_jobs/{jobId} {
      allow read: if signedIn()
          && (isConfiguredAdmin()
            || ownsGarmentCareOrder(resource.data.orderId)
            || isActiveGarmentCarePartner(
              resource.data.assignedPartnerAccountId,
              resource.data.assignedPartnerProfileId
            ));
      allow create, update, delete: if false;

      match /events/{eventId} {
        allow read: if signedIn()
          && (isConfiguredAdmin()
            || ownsGarmentCareOrder(get(
              /databases/$(database)/documents/garment_care_service_jobs/$(jobId)
            ).data.orderId)
            || isActiveGarmentCarePartner(
              get(/databases/$(database)/documents/garment_care_service_jobs/$(jobId)).data.assignedPartnerAccountId,
              get(/databases/$(database)/documents/garment_care_service_jobs/$(jobId)).data.assignedPartnerProfileId
            ));
        allow create, update, delete: if false;
      }
    }

    match /garment_care_quote_versions/{quoteId} {
      allow read: if signedIn()
          && (resource.data.customerUid == request.auth.uid || isConfiguredAdmin());
      allow create, update, delete: if false;
    }
    match /garment_care_invoices/{invoiceId} {
      allow read: if signedIn()
          && (resource.data.get('customerUid', null) == request.auth.uid
            || (resource.data.get('orderId', null) is string
              && ownsGarmentCareOrder(resource.data.orderId))
            || isConfiguredAdmin());
      allow create, update, delete: if false;
    }
    match /garment_care_consents/{consentId} {
      allow read: if signedIn()
          && (resource.data.customerUid == request.auth.uid || isConfiguredAdmin());
      allow create, update, delete: if false;
    }
    match /garment_care_shipments/{shipmentId} {
      allow read: if signedIn()
          && (ownsGarmentCareOrder(resource.data.orderId)
            || isConfiguredAdmin()
            || isActiveGarmentCarePartner(
              resource.data.get('assignedPartnerAccountId', null),
              resource.data.get('assignedPartnerProfileId', null)
            )
            || isActiveGarmentCarePartner(
              resource.data.get('fromPartnerAccountId', null),
              resource.data.get('fromPartnerProfileId', null)
            )
            || isActiveGarmentCarePartner(
              resource.data.get('toPartnerAccountId', null),
              resource.data.get('toPartnerProfileId', null)
            )
            || isActiveGarmentCareDeliveryPartner(
              resource.data.get('deliveryPartnerAccountId', null),
              resource.data.get('deliveryPartnerProfileId', null)
            )
            || isActiveGarmentCareDeliveryPartner(
              resource.data.get('fromPartnerAccountId', null),
              resource.data.get('fromPartnerProfileId', null)
            )
            || isActiveGarmentCareDeliveryPartner(
              resource.data.get('toPartnerAccountId', null),
              resource.data.get('toPartnerProfileId', null)
            ));
      allow create, update, delete: if false;
    }
    match /garment_care_custody_events/{eventId} {
      allow read: if signedIn()
          && (ownsGarmentCareOrder(resource.data.orderId)
            || isConfiguredAdmin()
            || (resource.data.releasingPartnerAccountId is string
              && isActiveGarmentCarePartner(
                resource.data.releasingPartnerAccountId,
                resource.data.releasingPartnerProfileId
              ))
            || (resource.data.receivingPartnerAccountId is string
              && isActiveGarmentCarePartner(
                resource.data.receivingPartnerAccountId,
                resource.data.receivingPartnerProfileId
              ))
            || isActiveGarmentCareDeliveryPartner(
              resource.data.get('releasingPartnerAccountId', null),
              resource.data.get('releasingPartnerProfileId', null)
            )
            || isActiveGarmentCareDeliveryPartner(
              resource.data.get('receivingPartnerAccountId', null),
              resource.data.get('receivingPartnerProfileId', null)
            ));
      allow create, update, delete: if false;
    }
    match /garment_care_history_events/{eventId} {
      allow read: if signedIn()
          && resource.data.customerUid == request.auth.uid;
      allow create, update, delete: if false;
    }
    match /garment_care_packages/{packageId} {
      allow read: if signedIn()
          && (ownsGarmentCareOrder(resource.data.orderId) || isConfiguredAdmin());
      allow create, update, delete: if false;
    }
    match /garment_care_package_events/{eventId} {
      allow read: if signedIn()
          && (ownsGarmentCareOrder(resource.data.orderId) || isConfiguredAdmin());
      allow create, update, delete: if false;
    }
    match /garment_care_payments/{paymentId} {
      allow read: if signedIn()
          && (resource.data.customerUid == request.auth.uid || isConfiguredAdmin());
      allow create, update, delete: if false;
    }
    match /garment_care_payment_batches/{paymentBatchId} {
      allow read: if signedIn()
          && (resource.data.customerUid == request.auth.uid || isConfiguredAdmin());
      allow create, update, delete: if false;
    }
    match /garment_care_payment_allocations/{allocationId} {
      allow read: if isConfiguredAdmin();
      allow create, update, delete: if false;
    }
    match /garment_care_payment_events/{eventId} {
      allow read: if isConfiguredAdmin();
      allow create, update, delete: if false;
    }
    match /garment_care_partner_quote_rates/{quoteId} {
      allow read: if isConfiguredAdmin();
      allow create, update, delete: if false;
    }
    match /garment_care_partner_payables/{entryId} {
      allow read: if isConfiguredAdmin()
          || isActiveGarmentCarePartner(
            resource.data.partnerAccountId,
            resource.data.partnerProfileId
          );
      allow create, update, delete: if false;
    }
    match /garment_care_settlement_cycles/{cycleId} {
      allow read: if isConfiguredAdmin();
      allow create, update, delete: if false;
    }
    match /garment_care_settlement_transfers/{transferId} {
      allow read: if isConfiguredAdmin()
          || (resource.data.partnerAccountId is string
            && isActiveGarmentCarePartner(
              resource.data.partnerAccountId,
              resource.data.partnerProfileId
            ));
      allow create, update, delete: if false;
    }
    match /garment_care_reconciliation_batches/{batchId} {
      allow read: if isConfiguredAdmin();
      allow create, update, delete: if false;
    }
    match /garment_care_claims/{claimId} {
      allow read: if signedIn()
          && (resource.data.customerUid == request.auth.uid || isConfiguredAdmin());
      allow create, update, delete: if false;
    }

    // Customer-owned design references. Catalogue images remain in their
    // canonical design/version documents and are never copied into a wishlist.
    match /customer_wishlists/{userId}/items/{itemId} {
      allow read, delete: if signedIn() && request.auth.uid == userId;
      allow create, update: if signedIn()
          && request.auth.uid == userId
          && request.resource.data.designId is string
          && request.resource.data.designId.size() > 0
          && request.resource.data.catalogueVersionId is string
          && request.resource.data.catalogueVersionId.size() > 0
          && request.resource.data.keys().hasOnly([
            'designId', 'catalogueVersionId', 'savedAt',
            'fabricPhotoStoragePath', 'fabricPreviewStoragePath',
            'fabricMetadata'
          ]);
    }

    // Drafts remain editable by their owning Customer and readable by that
    // Customer's owned account so the existing account-scoped draft list works.
    match /order_drafts/{draftId} {
      allow read: if signedIn()
          && (resource.data.customerUid == request.auth.uid
            || (resource.data.accountId is string
              && ownsExistingAccount(resource.data.accountId)));
      allow create: if signedIn()
          && request.resource.data.customerUid == request.auth.uid
          && request.resource.data.accountId is string
          && request.resource.data.customerProfileId is string
          && ownsActiveCustomerProfile(
            request.resource.data.accountId,
            request.resource.data.customerProfileId
          );
      allow update: if signedIn()
          && (resource.data.customerUid == request.auth.uid
            || (resource.data.accountId is string
              && ownsExistingAccount(resource.data.accountId)))
          && request.resource.data.customerUid == request.auth.uid
          && request.resource.data.accountId == resource.data.accountId
          && request.resource.data.customerProfileId is string
          && ownsActiveCustomerProfile(
            request.resource.data.accountId,
            request.resource.data.customerProfileId
          );
      allow delete: if signedIn()
          && (resource.data.customerUid == request.auth.uid
            || (resource.data.accountId is string
              && ownsExistingAccount(resource.data.accountId)));
    }

    // Help requests and generated consultation links are written by the trusted
    // backend; customers can read only their own requests and Admin can review.
    match /customer_consultations/{userId}/requests/{requestId} {
      allow read: if signedIn()
          && (request.auth.uid == userId || isConfiguredAdmin());
      allow write: if false;
    }

    // Assignment candidate lists and capacity reservations are server-only.
    match /order_assignment_state/{orderId} {
      allow read, write: if false;
    }
    match /order_tracking_codes/{trackingId} {
      allow read, write: if false;
    }
    match /tailor_capacity/{capacityId} {
      allow read, write: if false;
    }
    match /tailor_capacity_reservations/{orderId} {
      allow read, write: if false;
    }
    match /tailor_routing_priorities/{areaId} {
      allow read, write: if false;
    }

    // =====================================================
    // RULE-ID: COLL-DESIGN-TEMPLATES
    // ACTOR: Authenticated user
    // RESOURCE: Design template
    // OPERATION: Read, create, or owner-maintain design template
    // PURPOSE: Restricts update and delete to the template creator.
    // =====================================================
    match /designTemplates/{docId} {
      allow read: if signedIn();
      allow create: if signedIn();
      allow update, delete: if signedIn()
          && resource.data.createdBy == request.auth.uid;
    }

    // Governed monochrome catalogue designs. Partner drafts are private to the
    // submitting UID; customers can read only approved, published catalogue
    // records. Admin review and publication use the configured Admin UID list.
    // =====================================================
    // RULE-ID: COLL-CATALOGUE-DESIGNS
    // ACTOR: Approved Designer Partner, configured Admin, or signed-in customer
    // RESOURCE: Catalogue design, version, source view, and review event
    // OPERATION: Create/read/update governed catalogue content
    // PURPOSE: Protects immutable ownership and the Admin publication gate.
    // =====================================================
    match /designs/{designId} {
      allow get, list: if signedIn()
        && (
          isConfiguredAdmin()
          || resource.data.submittedByUid == request.auth.uid
          || (
            resource.data.lifecycleStatus == 'approved'
            && resource.data.publicationStatus == 'published'
            && resource.data.commercial is map
            && resource.data.commercial.commercialType in [
              'free', 'paid', 'premium'
            ]
          )
        );

      allow create: if signedIn()
        && request.resource.data.designId == designId
        && request.resource.data.submittedByUid == request.auth.uid
        && request.resource.data.lifecycleStatus == 'draft'
        && request.resource.data.publicationStatus == 'unpublished'
        && request.resource.data.activeVersionId == null
        && (
          (
            isConfiguredAdmin()
            && request.resource.data.ownerType == 'suisakhi'
          )
          || (
            request.resource.data.ownerType == 'designer'
            && request.resource.data.ownerAccountId is string
            && request.resource.data.ownerProfileId is string
            && isApprovedCatalogueDesigner(
              request.resource.data.ownerAccountId,
              request.resource.data.ownerProfileId
            )
            && request.resource.data.catalogueAgreement is map
            && request.resource.data.catalogueAgreement.acceptedByUid
              == request.auth.uid
            && request.resource.data.catalogueAgreement.actorType
              == 'designerPartner'
            && request.resource.data.catalogueAgreement.partnerProfileId
              == request.resource.data.ownerProfileId
            && request.resource.data.catalogueAgreement.agreementCode is string
            && request.resource.data.catalogueAgreement.agreementCode.size() > 0
            && request.resource.data.catalogueAgreement.agreementVersion is string
            && request.resource.data.catalogueAgreement.agreementVersion.size() > 0
            && request.resource.data.rightsDeclaration is map
            && request.resource.data.rightsDeclaration.acceptedByUid
              == request.auth.uid
            && request.resource.data.rightsDeclaration.originalWorkDeclared
              == true
            && request.resource.data.rightsDeclaration.rightsConfirmed == true
          )
        );

      allow update: if isConfiguredAdmin()
        || (
          signedIn()
          && resource.data.ownerType == 'designer'
          && resource.data.submittedByUid == request.auth.uid
          && request.resource.data.designId == resource.data.designId
          && request.resource.data.ownerType == resource.data.ownerType
          && request.resource.data.ownerAccountId == resource.data.ownerAccountId
          && request.resource.data.ownerProfileId == resource.data.ownerProfileId
          && request.resource.data.submittedByUid == resource.data.submittedByUid
          && request.resource.data.publicationStatus == resource.data.publicationStatus
          && request.resource.data.get('publishedByUid', null)
            == resource.data.get('publishedByUid', null)
          && request.resource.data.get('publishedAt', null)
            == resource.data.get('publishedAt', null)
          && request.resource.data.commercial.approvedDesignCharge
            == resource.data.commercial.approvedDesignCharge
          && request.resource.data.lifecycleStatus in [
            'draft', 'uploaded', 'readyForReview', 'changesRequested'
          ]
          && (
            (
              resource.data.lifecycleStatus in ['draft', 'uploaded']
              && request.resource.data.lifecycleStatus in [
                'draft', 'uploaded', 'readyForReview'
              ]
            )
            || (
              resource.data.lifecycleStatus == 'changesRequested'
              && request.resource.data.lifecycleStatus in [
                'changesRequested', 'readyForReview'
              ]
            )
          )
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'title',
            'description',
            'garmentTypeCodes',
            'occasionCodes',
            'styleCodes',
            'fabricCompatibilityCodes',
            'eventCapabilityTags',
            'constructionMetadata',
            'commercial',
            'activeVersionId',
            'lifecycleStatus',
            'processingStatus',
            'reviewNotes',
            'rejectionReason',
            'submittedAt',
            'updatedAt',
            'reviewedVersionId',
            'latestReviewEventId',
            'changeRequestScope',
            'affectedViewIds',
            'correctionDraftVersionId'
          ])
        );

      allow delete: if false;

      match /versions/{versionId} {
        function parentDesign() {
          return get(
            /databases/$(database)/documents/designs/$(designId)
          ).data;
        }

        function canReadCatalogueVersion() {
          return signedIn()
            && (
              isConfiguredAdmin()
              || parentDesign().submittedByUid == request.auth.uid
              || (
                parentDesign().lifecycleStatus == 'approved'
                && parentDesign().publicationStatus == 'published'
                && parentDesign().commercial is map
                && parentDesign().commercial.commercialType in [
                  'free', 'paid', 'premium'
                ]
              )
            );
        }

        function canWriteCatalogueVersion() {
          return signedIn()
            && (
              isConfiguredAdmin()
              || (
                parentDesign().ownerType == 'designer'
                && parentDesign().submittedByUid == request.auth.uid
                && parentDesign().publicationStatus != 'published'
                && parentDesign().lifecycleStatus in [
                  'draft', 'uploaded', 'changesRequested'
                ]
              )
            );
        }

        allow read: if canReadCatalogueVersion();
        allow create: if canWriteCatalogueVersion()
          && request.resource.data.designId == designId
          && request.resource.data.versionId == versionId
          && request.resource.data.submittedByUid == request.auth.uid;
        allow update: if isConfiguredAdmin()
          || (
            canWriteCatalogueVersion()
            && request.resource.data.designId == resource.data.designId
            && request.resource.data.versionId == resource.data.versionId
            && request.resource.data.submittedByUid == request.auth.uid
            && request.resource.data.get('versionStatus', 'draft')
              in ['draft', 'submitted']
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
              'primaryViewId',
              'viewCount',
              'processing',
              'updatedAt',
              'versionStatus',
              'submittedByUid',
              'submittedAt'
            ])
          );
        allow delete: if false;

        match /views/{viewId} {
          allow read: if canReadCatalogueVersion();
          allow create: if canWriteCatalogueVersion()
            && request.resource.data.designId == designId
            && request.resource.data.versionId == versionId
            && request.resource.data.viewId == viewId
            && request.resource.data.originalAsset is map
            && request.resource.data.originalAsset.storagePath is string
            && request.resource.data.originalAsset.mimeType in [
              'image/jpeg', 'image/png', 'image/webp'
            ]
            && request.resource.data.originalAsset.byteSize is int
            && request.resource.data.originalAsset.byteSize > 0
            && request.resource.data.originalAsset.byteSize <= 12 * 1024 * 1024;
          allow update: if isConfiguredAdmin()
            || (
              canWriteCatalogueVersion()
              && request.resource.data.designId == resource.data.designId
              && request.resource.data.versionId == resource.data.versionId
              && request.resource.data.viewId == resource.data.viewId
              && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
                'viewType',
                'isPrimary',
                'excludedFromVersion',
                'replacedByViewId',
                'updatedAt'
              ])
            );
          allow delete: if false;
        }

        match /generated_view_candidates/{candidateId} {
          allow read: if signedIn()
            && (
              isConfiguredAdmin()
              || parentDesign().submittedByUid == request.auth.uid
            );
          allow write: if false;
        }

        match /view_reconstruction_runs/{runId} {
          allow read: if signedIn()
            && (
              isConfiguredAdmin()
              || parentDesign().submittedByUid == request.auth.uid
            );
          allow write: if false;
        }
      }

      match /review_events/{eventId} {
        allow read: if isConfiguredAdmin()
          || (
            signedIn()
            && get(
              /databases/$(database)/documents/designs/$(designId)
            ).data.submittedByUid == request.auth.uid
          );
        allow create: if signedIn()
          && request.resource.data.eventId == eventId
          && request.resource.data.designId == designId
          && request.resource.data.actorUid == request.auth.uid
          && (
            isConfiguredAdmin()
            || get(
              /databases/$(database)/documents/designs/$(designId)
            ).data.submittedByUid == request.auth.uid
          );
        allow update, delete: if false;
      }
    }

    // Private, profile-owned customer design references.
    // =====================================================
    // RULE-ID: COLL-CUSTOMER-DESIGNS
    // ACTOR: Design owner
    // RESOURCE: Private customer design
    // OPERATION: Create, read, or update owned design reference
    // PURPOSE: Protects profile-owned private design records and immutable ownership linkage.
    // =====================================================
    match /customer_designs/{designId} {
      allow create: if signedIn()
          && request.resource.data.createdByUid == request.auth.uid
          && request.resource.data.accountId is string
          && request.resource.data.accountId.size() > 0
          && request.resource.data.profileId is string
          && request.resource.data.profileId.size() > 0
          && request.resource.data.visibility == 'private'
          && request.resource.data.status == 'active';

      allow read: if signedIn()
          && resource.data.createdByUid == request.auth.uid;

      allow update: if signedIn()
          && resource.data.createdByUid == request.auth.uid
          && request.resource.data.createdByUid
              == resource.data.createdByUid
          && request.resource.data.accountId
              == resource.data.accountId
          && request.resource.data.profileId
              == resource.data.profileId
          && request.resource.data.visibility
              == resource.data.visibility;

      allow delete: if false;
    }

    // =====================================================
    // RULE-ID: COLL-SUPPORT-TICKETS
    // ACTOR: Ticket owner, configured support agent, or configured Admin
    // RESOURCE: Customer support ticket
    // OPERATION: Create, read, or update support request lifecycle
    // PURPOSE: Customers can submit and read their own requests; only configured support staff/Admin can see all requests and change status.
    // =====================================================
    match /support_tickets/{ticketId} {
      allow create: if signedIn()
        && request.resource.data.keys().hasOnly([
          'customerUid',
          'customerName',
          'category',
          'subject',
          'message',
          'linkedOrderId',
          'assignedTeam',
          'status',
          'source',
          'languageCode',
          'createdAt',
          'updatedAt'
        ])
        && request.resource.data.keys().hasAll([
          'customerUid',
          'customerName',
          'category',
          'subject',
          'message',
          'linkedOrderId',
          'assignedTeam',
          'status',
          'source',
          'languageCode',
          'createdAt',
          'updatedAt'
        ])
        && request.resource.data.customerUid == request.auth.uid
        && request.resource.data.customerName is string
        && request.resource.data.customerName.size() <= 100
        && request.resource.data.category in [
          'Order Issue',
          'Measurement Issue',
          'Fabric Issue',
          'Designer Issue',
          'Payment Issue',
          'Garment Care Issue',
          'Delivery Issue',
          'Other'
        ]
        && request.resource.data.subject is string
        && request.resource.data.subject.size() > 0
        && request.resource.data.subject.size() <= 100
        && request.resource.data.message is string
        && request.resource.data.message.size() >= 5
        && request.resource.data.message.size() <= 2000
        && (
          request.resource.data.linkedOrderId == null
          || (
            request.resource.data.linkedOrderId is string
            && exists(
              /databases/$(database)/documents/orders/$(request.resource.data.linkedOrderId)
            )
            && get(
              /databases/$(database)/documents/orders/$(request.resource.data.linkedOrderId)
            ).data.customerId == request.auth.uid
          )
        )
        && request.resource.data.assignedTeam in [
          'orders',
          'measurements',
          'design_and_fabric',
          'payments',
          'garment_care',
          'delivery',
          'customer_support'
        ]
        && request.resource.data.status == 'Open'
        && request.resource.data.source == 'customer_helpdesk'
        && request.resource.data.languageCode == 'en'
        && request.resource.data.createdAt == request.time
        && request.resource.data.updatedAt == request.time;

      allow read: if signedIn()
        && (
          resource.data.customerUid == request.auth.uid
          || isConfiguredSupportAgent()
          || isConfiguredAdmin()
        );

      allow update: if (isConfiguredSupportAgent() || isConfiguredAdmin())
        && request.resource.data.customerUid == resource.data.customerUid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'status',
          'assignedTeam',
          'response',
          'updatedAt',
          'resolvedAt'
        ])
        && request.resource.data.status in [
          'Open',
          'In Progress',
          'Waiting Customer',
          'Resolved',
          'Closed'
        ]
        && request.resource.data.updatedAt == request.time;

      allow delete: if false;
    }

    // =====================================================
    // RULE-ID: COLL-STORE-PRODUCTS
    // ACTOR: Store Customer, Brand/Boutique Partner, or configured Admin
    // RESOURCE: Fashion Store product listing
    // OPERATION: Read published listings or manage owned Partner listings
    // PURPOSE: Keeps unpublished listings private and scopes all Partner
    //          writes to the approved Brand/Boutique profile that created them.
    // =====================================================
    match /store_products/{productId} {
      allow get, list: if isConfiguredAdmin()
        || resource.data.status == 'published'
        || (
          resource.data.partnerAccountId is string
          && resource.data.partnerProfileId is string
          && resource.data.createdByUid == request.auth.uid
          && isApprovedFashionStorePartner(
            resource.data.partnerAccountId,
            resource.data.partnerProfileId
          )
        );

      allow create: if signedIn()
        && request.resource.data.keys().hasOnly([
          'partnerAccountId',
          'partnerProfileId',
          'partnerType',
          'sellerName',
          'name',
          'description',
          'categoryCode',
          'categoryLabel',
          'subcategory',
          'priceInr',
          'discountPriceInr',
          'stockQuantity',
          'status',
          'brandName',
          'unit',
          'fabricComposition',
          'fabricWidth',
          'minimumQuantity',
          'sizes',
          'colors',
          'images',
          'createdByUid',
          'createdAt',
          'updatedAt'
        ])
        && request.resource.data.keys().hasAll([
          'partnerAccountId',
          'partnerProfileId',
          'partnerType',
          'sellerName',
          'name',
          'description',
          'categoryCode',
          'categoryLabel',
          'subcategory',
          'priceInr',
          'discountPriceInr',
          'stockQuantity',
          'status',
          'brandName',
          'unit',
          'fabricComposition',
          'fabricWidth',
          'minimumQuantity',
          'sizes',
          'colors',
          'images',
          'createdByUid',
          'createdAt',
          'updatedAt'
        ])
        && isApprovedFashionStorePartner(
          request.resource.data.partnerAccountId,
          request.resource.data.partnerProfileId
        )
        && request.resource.data.partnerType in ['brand', 'boutique']
        && request.resource.data.createdByUid == request.auth.uid
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0
        && request.resource.data.name.size() <= 120
        && request.resource.data.description is string
        && request.resource.data.description.size() <= 3000
        && request.resource.data.categoryCode in [
          'ready_to_wear', 'fabric', 'accessories', 'kids_fashion'
        ]
        && request.resource.data.subcategory is string
        && request.resource.data.subcategory.size() > 0
        && request.resource.data.subcategory.size() <= 100
        && request.resource.data.priceInr is number
        && request.resource.data.priceInr > 0
        && (
          request.resource.data.discountPriceInr == null
          || (
            request.resource.data.discountPriceInr is number
            && request.resource.data.discountPriceInr > 0
            && request.resource.data.discountPriceInr
                < request.resource.data.priceInr
          )
        )
        && request.resource.data.stockQuantity is int
        && request.resource.data.stockQuantity >= 0
        && request.resource.data.status in ['draft', 'published', 'paused']
        && request.resource.data.unit in ['piece', 'metre']
        && request.resource.data.minimumQuantity is int
        && request.resource.data.minimumQuantity > 0
        && request.resource.data.sizes is list
        && request.resource.data.colors is list
        && request.resource.data.images is list
        && request.resource.data.images.size() <= 5
        && request.resource.data.createdAt == request.time
        && request.resource.data.updatedAt == request.time;

      allow update: if isConfiguredAdmin()
        || (
          signedIn()
          && resource.data.createdByUid == request.auth.uid
          && isApprovedFashionStorePartner(
            resource.data.partnerAccountId,
            resource.data.partnerProfileId
          )
          && request.resource.data.partnerAccountId
              == resource.data.partnerAccountId
          && request.resource.data.partnerProfileId
              == resource.data.partnerProfileId
          && request.resource.data.partnerType == resource.data.partnerType
          && request.resource.data.createdByUid == resource.data.createdByUid
          && request.resource.data.createdAt == resource.data.createdAt
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'sellerName',
            'name',
            'description',
            'categoryCode',
            'categoryLabel',
            'subcategory',
            'priceInr',
            'discountPriceInr',
            'stockQuantity',
            'status',
            'brandName',
            'unit',
            'fabricComposition',
            'fabricWidth',
            'minimumQuantity',
            'sizes',
            'colors',
            'images',
            'updatedAt'
          ])
          && request.resource.data.name is string
          && request.resource.data.name.size() > 0
          && request.resource.data.name.size() <= 120
          && request.resource.data.description is string
          && request.resource.data.description.size() <= 3000
          && request.resource.data.categoryCode in [
            'ready_to_wear', 'fabric', 'accessories', 'kids_fashion'
          ]
          && request.resource.data.subcategory is string
          && request.resource.data.subcategory.size() > 0
          && request.resource.data.subcategory.size() <= 100
          && request.resource.data.priceInr is number
          && request.resource.data.priceInr > 0
          && (
            request.resource.data.discountPriceInr == null
            || (
              request.resource.data.discountPriceInr is number
              && request.resource.data.discountPriceInr > 0
              && request.resource.data.discountPriceInr
                  < request.resource.data.priceInr
            )
          )
          && request.resource.data.stockQuantity is int
          && request.resource.data.stockQuantity >= 0
          && request.resource.data.status in ['draft', 'published', 'paused']
          && request.resource.data.unit in ['piece', 'metre']
          && request.resource.data.minimumQuantity is int
          && request.resource.data.minimumQuantity > 0
          && request.resource.data.sizes is list
          && request.resource.data.colors is list
          && request.resource.data.images is list
          && request.resource.data.images.size() <= 5
          && request.resource.data.updatedAt == request.time
        );

      allow delete: if false;
    }

    // =====================================================
    // RULE-ID: COLL-SUBSCRIPTIONS
    // ACTOR: Authenticated user
    // RESOURCE: Subscription
    // OPERATION: Read or write subscription
    // PURPOSE: Retains current authenticated access pending plan-specific hardening.
    // =====================================================
    match /subscriptions/{docId} {
      allow read, write: if signedIn();
    }
  }
}
